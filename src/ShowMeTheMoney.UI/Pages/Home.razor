@page "/"

<PageTitle>Show Me The Money</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">Your money, made visible</p>
        <h1>Accounts</h1>
        <p class="hero-copy">
            Add an account, select it, then import its QIF transaction history.
        </p>
    </div>
</section>

@if (availableUpdate is not null)
{
    <section class="update-card">
        <div>
            <p class="eyebrow">Update available</p>
            <strong>Show Me The Money @availableUpdate.Version is ready</strong>
            <span>
                @(isInstallingUpdate
                    ? "Downloading and preparing the update..."
                    : "Install it now and the app will restart automatically.")
            </span>
        </div>
        <button class="primary-button"
                @onclick="InstallUpdateAsync"
                disabled="@isInstallingUpdate">
            @(isInstallingUpdate ? "Installing..." : "Update and restart")
        </button>
    </section>
}

@if (actionMessage is not null)
{
    <div class="message import-message">@actionMessage</div>
}

@if (errorMessage is not null)
{
    <div class="message error-message">@errorMessage</div>
}
else if (overview is null)
{
    <div class="loading-card">Loading accounts...</div>
}
else
{
    <section class="account-workspace">
        <article class="panel accounts-panel">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">Your accounts</p>
                    <h2>Accounts</h2>
                </div>
                <span>@overview.Accounts.Count</span>
            </div>

            @if (overview.Accounts.Count > 0)
            {
                <div class="account-list">
                    @foreach (var account in overview.Accounts)
                    {
                        <button class="account-row @(account.Id == selectedAccountId ? "selected" : null)"
                                @onclick="() => SelectAccountAsync(account.Id)">
                            <div>
                                <strong>@account.Name</strong>
                                <span>@FormatOptionalMoney(account.Balance)</span>
                            </div>
                            <span class="account-chevron">›</span>
                        </button>
                    }
                </div>
            }

            <div class="add-account-form">
                <label for="new-account-name">Add an account</label>
                <div class="inline-form">
                    <input id="new-account-name"
                           placeholder="e.g. Everyday account"
                           @bind="newAccountName"
                           @bind:event="oninput"
                           @onkeydown="HandleAddAccountKeyDown" />
                    <button class="primary-button"
                            @onclick="AddAccountAsync"
                            disabled="@isWorking">
                        Add
                    </button>
                </div>
            </div>
        </article>

        @if (SelectedAccount is null)
        {
            <section class="empty-state">
                <div class="empty-state-icon">1</div>
                <p class="eyebrow">First step</p>
                <h2>Add your first account</h2>
                <p>
                    Give the account a useful name. Once selected, you can import
                    its QIF transaction history.
                </p>
            </section>
        }
        else
        {
            <div class="account-detail">
                <section class="selected-account-header">
                    <div>
                        <p class="eyebrow">Selected account</p>
                        <div class="account-settings-form">
                            <label>
                                <span>Account name</span>
                                <input aria-label="Account name"
                                       @bind="editedAccountName"
                                       @bind:event="oninput"
                                       disabled="@(!isEditingAccount)"
                                       @onkeydown="HandleAccountKeyDown" />
                            </label>
                            <label>
                                <span>Current balance</span>
                                <input type="number"
                                       step="0.01"
                                       aria-label="Current balance"
                                       @bind="editedBalance"
                                       disabled="@(!isEditingAccount)"
                                       @onkeydown="HandleAccountKeyDown" />
                            </label>
                            <div class="account-edit-actions">
                                @if (isEditingAccount)
                                {
                                    <button class="primary-button"
                                            @onclick="SaveAccountAsync"
                                            disabled="@isWorking">
                                        Save
                                    </button>
                                    <button class="secondary-button"
                                            @onclick="CancelAccountEditing"
                                            disabled="@isWorking">
                                        Cancel
                                    </button>
                                }
                                else
                                {
                                    <button class="secondary-button"
                                            @onclick="BeginAccountEditing"
                                            disabled="@isWorking">
                                        Edit account
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <button class="primary-button"
                            @onclick="ImportQifAsync"
                            disabled="@isWorking">
                        @(isWorking ? "Working..." : "Import QIF")
                    </button>
                </section>

                <article class="panel transactions-panel">
                    <div class="panel-heading">
                        <div>
                            <p class="eyebrow">@SelectedAccount.Name</p>
                            <h2>Transactions</h2>
                        </div>
                        <div class="transaction-heading-actions">
                            <span>@overview.DataSourceDescription</span>
                            <button class="secondary-button compact-button"
                                    @onclick="ApplyCategoryRulesAsync"
                                    disabled="@isWorking">
                                Apply category rules
                            </button>
                        </div>
                    </div>

                    @if (transactionCount == 0)
                    {
                        <div class="transaction-empty-state">
                            <strong>No transactions imported</strong>
                            <span>Use Import QIF to add this account's transaction history.</span>
                        </div>
                    }
                    else
                    {
                        <div class="transaction-header">
                            <span>Date</span>
                            <span>Description</span>
                            <span>Credit</span>
                            <span>Debit</span>
                            <span>Balance</span>
                        </div>
                        <div class="transaction-list">
                            @foreach (var entry in transactionPage)
                            {
                                var transaction = entry.Transaction;
                                <div class="transaction-row">
                                    <div class="transaction-date">
                                        <strong>@transaction.PostedOn.Day</strong>
                                        <span>@transaction.PostedOn.ToString("MMM yyyy")</span>
                                    </div>
                                    <div class="transaction-description">
                                        <strong>@transaction.Description</strong>
                                        <select class="transaction-category"
                                                aria-label="@($"Category for {transaction.Description}")"
                                                value="@transaction.Category"
                                                @onchange="args => HandleTransactionCategoryChangeAsync(transaction, args)"
                                                disabled="@(isWorking || isLoadingTransactions)">
                                            @foreach (var category in GetCategoryOptions(transaction.Category))
                                            {
                                                <option value="@category">@category</option>
                                            }
                                            <option value="@NewCategoryOption">New...</option>
                                        </select>
                                    </div>
                                    <strong class="positive numeric-cell">
                                        @(transaction.Amount > 0 ? FormatMoney(transaction.Amount) : null)
                                    </strong>
                                    <strong class="negative numeric-cell">
                                        @(transaction.Amount < 0 ? FormatMoney(-transaction.Amount) : null)
                                    </strong>
                                    <strong class="numeric-cell">
                                        @FormatOptionalMoney(entry.RunningBalance)
                                    </strong>
                                </div>
                            }
                        </div>
                        <div class="transaction-pagination">
                            <span>
                                Showing @TransactionPageStart-@TransactionPageEnd
                                of @transactionCount
                            </span>
                            <div>
                                <button class="secondary-button compact-button"
                                        @onclick="ShowPreviousTransactionPage"
                                        disabled="@(isWorking || isLoadingTransactions || transactionPageIndex == 0)">
                                    Previous
                                </button>
                                <strong>
                                    Page @(transactionPageIndex + 1) of @TransactionPageCount
                                </strong>
                                <button class="secondary-button compact-button"
                                        @onclick="ShowNextTransactionPage"
                                        disabled="@(isWorking || isLoadingTransactions || transactionPageIndex >= TransactionPageCount - 1)">
                                    Next
                                </button>
                            </div>
                        </div>
                    }
                </article>
            </div>
        }
    </section>
}

@if (updateError is not null)
{
    <div class="message error-message update-message">@updateError</div>
}

@if (transactionForNewCategory is not null)
{
    <div class="dialog-backdrop">
        <section class="category-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="new-category-title">
            <p class="eyebrow">Custom category</p>
            <h2 id="new-category-title">Create a category</h2>
            <p class="muted">
                Create a category for
                <strong>@transactionForNewCategory.Description</strong>:
            </p>
            <label>
                <span>Category name</span>
                <input autofocus
                       aria-label="New category name"
                       @bind="newCategoryName"
                       @bind:event="oninput"
                       @onkeydown="HandleNewCategoryKeyDown" />
            </label>
            @if (newCategoryError is not null)
            {
                <span class="dialog-error">@newCategoryError</span>
            }
            <div class="dialog-actions">
                <button class="secondary-button"
                        @onclick="CancelNewCategory"
                        disabled="@isWorking">
                    Cancel
                </button>
                <button class="primary-button"
                        @onclick="SaveNewCategoryAsync"
                        disabled="@isWorking">
                    Continue
                </button>
            </div>
        </section>
    </div>
}

@if (assignmentTransaction is not null
    && assignmentCategory is not null
    && assignmentPreview is not null)
{
    <div class="dialog-backdrop">
        <section class="category-dialog assignment-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="assignment-title">
            <p class="eyebrow">Apply category</p>
            <h2 id="assignment-title">@assignmentCategory</h2>
            <p class="muted">
                <strong>@assignmentTransaction.Description</strong> has
                @assignmentPreview.OtherMatchingCount other matching
                @(assignmentPreview.OtherMatchingCount == 1 ? "transaction" : "transactions").
                @assignmentPreview.OtherUncategorisedCount of those
                @(assignmentPreview.OtherUncategorisedCount == 1 ? "is" : "are")
                uncategorised.
            </p>
            <div class="assignment-actions">
                <button class="primary-button"
                        @onclick="() => ConfirmAssignmentAsync(TransactionCategoryAssignmentScope.AllMatching)"
                        disabled="@isWorking">
                    Update all @(assignmentPreview.OtherMatchingCount + 1) transactions
                </button>
                <button class="secondary-button"
                        @onclick="() => ConfirmAssignmentAsync(TransactionCategoryAssignmentScope.MatchingUncategorised)"
                        disabled="@(isWorking || assignmentPreview.OtherUncategorisedCount == 0)">
                    Update this and @assignmentPreview.OtherUncategorisedCount uncategorised
                </button>
                <button class="secondary-button"
                        @onclick="() => ConfirmAssignmentAsync(TransactionCategoryAssignmentScope.SelectedOnly)"
                        disabled="@isWorking">
                    Do nothing to other transactions
                </button>
                <button class="secondary-button"
                        @onclick="CancelAssignment"
                        disabled="@isWorking">
                    Cancel
                </button>
            </div>
        </section>
    </div>
}

@code {
    private const string NewCategoryOption = "__new_category__";
    private const int TransactionPageSize = 50;

    [Inject]
    private IBankingDataSource DataSource { get; set; } = null!;

    [Inject]
    private IBankingDataStore DataStore { get; set; } = null!;

    [Inject]
    private IQifFilePicker FilePicker { get; set; } = null!;

    [Inject]
    private QifParser Parser { get; set; } = null!;

    [Inject]
    private IApplicationUpdateService UpdateService { get; set; } = null!;

    private BankingOverview? overview;
    private string? selectedAccountId;
    private string newAccountName = string.Empty;
    private string editedAccountName = string.Empty;
    private decimal? editedBalance;
    private string? errorMessage;
    private string? actionMessage;
    private string? updateError;
    private ApplicationUpdate? availableUpdate;
    private bool isWorking;
    private bool isInstallingUpdate;
    private bool isEditingAccount;
    private BankTransaction? transactionForNewCategory;
    private BankTransaction? assignmentTransaction;
    private string? assignmentCategory;
    private TransactionCategoryAssignmentPreview? assignmentPreview;
    private string newCategoryName = string.Empty;
    private string? newCategoryError;
    private IReadOnlyList<TransactionLedgerEntry> transactionPage = [];
    private int transactionCount;
    private int transactionPageIndex;
    private bool isLoadingTransactions;
    private IReadOnlyList<TransactionCategory> availableCategories = [];

    private BankAccount? SelectedAccount =>
        overview?.Accounts.FirstOrDefault(account => account.Id == selectedAccountId);

    private int TransactionPageCount =>
        Math.Max(1, (transactionCount + TransactionPageSize - 1) / TransactionPageSize);

    private int TransactionPageStart =>
        transactionCount == 0 ? 0 : (transactionPageIndex * TransactionPageSize) + 1;

    private int TransactionPageEnd =>
        Math.Min(transactionCount, (transactionPageIndex + 1) * TransactionPageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await CheckForUpdateAsync();
    }

    private async Task LoadAsync(
        string? accountToSelect = null,
        bool resetTransactionPage = true)
    {
        errorMessage = null;

        try
        {
            overview = await DataSource.GetOverviewAsync();
            availableCategories = await DataStore.GetTransactionCategoriesAsync();
            var desiredAccountId = accountToSelect ?? selectedAccountId;
            selectedAccountId = overview.Accounts.Any(account => account.Id == desiredAccountId)
                ? desiredAccountId
                : overview.Accounts.FirstOrDefault()?.Id;
            await UpdateSelectedAccountStateAsync(resetTransactionPage);
        }
        catch (Exception exception)
        {
            errorMessage = $"Accounts could not be loaded: {exception.Message}";
        }
    }

    private async Task SelectAccountAsync(string accountId)
    {
        selectedAccountId = accountId;
        actionMessage = null;
        errorMessage = null;
        await UpdateSelectedAccountStateAsync(resetTransactionPage: true);
    }

    private async Task UpdateSelectedAccountStateAsync(bool resetTransactionPage)
    {
        editedAccountName = SelectedAccount?.Name ?? string.Empty;
        editedBalance = SelectedAccount?.Balance;
        isEditingAccount = false;
        await LoadTransactionPageAsync(resetTransactionPage ? 0 : transactionPageIndex);
    }

    private async Task ShowPreviousTransactionPage()
    {
        if (transactionPageIndex == 0)
        {
            return;
        }

        await LoadTransactionPageAsync(transactionPageIndex - 1);
    }

    private async Task ShowNextTransactionPage()
    {
        if (transactionPageIndex >= TransactionPageCount - 1)
        {
            return;
        }

        await LoadTransactionPageAsync(transactionPageIndex + 1);
    }

    private async Task LoadTransactionPageAsync(int pageIndex)
    {
        if (selectedAccountId is null)
        {
            transactionPage = [];
            transactionCount = 0;
            transactionPageIndex = 0;
            return;
        }

        isLoadingTransactions = true;
        try
        {
            var page = await DataStore.GetTransactionPageAsync(
                selectedAccountId,
                pageIndex,
                TransactionPageSize);
            transactionPage = page.Entries;
            transactionCount = page.TotalCount;
            transactionPageIndex = page.PageIndex;
        }
        catch (Exception exception)
        {
            errorMessage = $"Transactions could not be loaded: {exception.Message}";
        }
        finally
        {
            isLoadingTransactions = false;
        }
    }

    private void BeginAccountEditing()
    {
        editedAccountName = SelectedAccount?.Name ?? string.Empty;
        editedBalance = SelectedAccount?.Balance;
        errorMessage = null;
        actionMessage = null;
        isEditingAccount = true;
    }

    private void CancelAccountEditing()
    {
        editedAccountName = SelectedAccount?.Name ?? string.Empty;
        editedBalance = SelectedAccount?.Balance;
        errorMessage = null;
        isEditingAccount = false;
    }

    private async Task AddAccountAsync()
    {
        var name = newAccountName.Trim();
        if (name.Length == 0)
        {
            errorMessage = "Enter an account name first.";
            return;
        }

        isWorking = true;
        errorMessage = null;
        actionMessage = null;
        var account = new BankAccount(
            Guid.NewGuid().ToString("N"),
            name,
            "Manual account",
            null,
            "AUD");

        try
        {
            await DataStore.AddAccountAsync(account);
            newAccountName = string.Empty;
            await LoadAsync(account.Id);
            actionMessage = $"Added {account.Name}.";
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task SaveAccountAsync()
    {
        var account = SelectedAccount;
        var name = editedAccountName.Trim();
        if (account is null || name.Length == 0)
        {
            errorMessage = "Enter an account name first.";
            return;
        }

        isWorking = true;
        errorMessage = null;
        actionMessage = null;

        try
        {
            await DataStore.UpdateAccountAsync(account.Id, name, editedBalance);
            await LoadAsync(account.Id, resetTransactionPage: false);
            actionMessage = $"Saved {name}.";
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task ImportQifAsync()
    {
        var account = SelectedAccount;
        if (account is null)
        {
            errorMessage = "Select an account before importing transactions.";
            return;
        }

        errorMessage = null;
        actionMessage = null;

        using var selectedFile = await FilePicker.PickAsync();
        if (selectedFile is null)
        {
            return;
        }

        isWorking = true;

        try
        {
            var result = Parser.Parse(selectedFile.Content, selectedFile.FileName);
            var transactions = result.Snapshot.Transactions
                .Select(transaction => transaction with
                {
                    Id = $"{account.Id}:{transaction.Id}",
                    AccountId = account.Id
                })
                .ToArray();
            await DataStore.ImportTransactionsAsync(
                account.Id,
                transactions,
                $"Last imported from {selectedFile.FileName}");
            await LoadAsync(account.Id);
            actionMessage = result.Warnings.Count == 0
                ? $"Imported or updated {transactions.Length} transactions in {account.Name}."
                : $"Imported or updated {transactions.Length} transactions with "
                    + $"{result.Warnings.Count} skipped records. {string.Join(" ", result.Warnings.Take(3))}";
        }
        catch (QifParseException exception)
        {
            errorMessage = exception.Message;
        }
        catch (IOException exception)
        {
            errorMessage = $"The QIF file could not be read or saved: {exception.Message}";
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task HandleTransactionCategoryChangeAsync(
        BankTransaction transaction,
        ChangeEventArgs args)
    {
        var category = args.Value?.ToString()?.Trim();
        if (string.IsNullOrWhiteSpace(category) || category == transaction.Category)
        {
            return;
        }

        if (category == NewCategoryOption)
        {
            transactionForNewCategory = transaction;
            newCategoryName = string.Empty;
            newCategoryError = null;
            return;
        }

        await PrepareAssignmentAsync(transaction, category);
    }

    private async Task PrepareAssignmentAsync(
        BankTransaction transaction,
        string category)
    {
        isWorking = true;
        errorMessage = null;
        actionMessage = null;

        try
        {
            assignmentPreview =
                await DataStore.GetTransactionCategoryAssignmentPreviewAsync(transaction.Id);
            assignmentTransaction = transaction;
            assignmentCategory = category;
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task SaveNewCategoryAsync()
    {
        if (isWorking)
        {
            return;
        }

        var transaction = transactionForNewCategory;
        var category = newCategoryName.Trim();
        if (transaction is null)
        {
            return;
        }

        if (category.Length == 0)
        {
            newCategoryError = "Enter a category name.";
            return;
        }

        if (category.Equals("Other", StringComparison.OrdinalIgnoreCase)
            || category.Equals("New...", StringComparison.OrdinalIgnoreCase))
        {
            newCategoryError = "Choose a more specific category name.";
            return;
        }

        CancelNewCategory();
        await PrepareAssignmentAsync(transaction, category);
    }

    private void CancelNewCategory()
    {
        transactionForNewCategory = null;
        newCategoryName = string.Empty;
        newCategoryError = null;
    }

    private async Task ConfirmAssignmentAsync(TransactionCategoryAssignmentScope scope)
    {
        var transaction = assignmentTransaction;
        var category = assignmentCategory;
        if (transaction is null || category is null)
        {
            return;
        }

        isWorking = true;
        errorMessage = null;
        actionMessage = null;
        try
        {
            await DataStore.SetTransactionCategoryAsync(transaction.Id, category, scope);
            CancelAssignment();
            await LoadAsync(transaction.AccountId, resetTransactionPage: false);
            actionMessage = scope switch
            {
                TransactionCategoryAssignmentScope.AllMatching =>
                    $"Categorised all matching transactions as {category}.",
                TransactionCategoryAssignmentScope.MatchingUncategorised =>
                    $"Categorised this and matching uncategorised transactions as {category}.",
                _ => $"Categorised only this transaction as {category}."
            };
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private void CancelAssignment()
    {
        assignmentTransaction = null;
        assignmentCategory = null;
        assignmentPreview = null;
    }

    private async Task HandleNewCategoryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SaveNewCategoryAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelNewCategory();
        }
    }

    private async Task ApplyCategoryRulesAsync()
    {
        var account = SelectedAccount;
        if (account is null)
        {
            return;
        }

        isWorking = true;
        errorMessage = null;
        actionMessage = null;

        try
        {
            var updatedCount = await DataStore.ApplyTransactionCategoryRulesAsync(account.Id);
            await LoadAsync(account.Id, resetTransactionPage: false);
            actionMessage = updatedCount == 0
                ? "No additional transactions matched the category rules."
                : $"Categorised {updatedCount} transaction"
                    + (updatedCount == 1 ? "." : "s.");
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task HandleAddAccountKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddAccountAsync();
        }
    }

    private async Task HandleAccountKeyDown(KeyboardEventArgs args)
    {
        if (!isEditingAccount)
        {
            return;
        }

        if (args.Key == "Enter")
        {
            await SaveAccountAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelAccountEditing();
        }
    }

    private async Task CheckForUpdateAsync()
    {
        if (!UpdateService.CanUpdate)
        {
            return;
        }

        try
        {
            availableUpdate = await UpdateService.CheckForUpdateAsync();
        }
        catch (ApplicationUpdateException exception)
        {
            updateError = exception.Message;
        }
    }

    private async Task InstallUpdateAsync()
    {
        isInstallingUpdate = true;
        updateError = null;

        try
        {
            await UpdateService.DownloadUpdateAsync();
            UpdateService.ApplyUpdateAndRestart();
        }
        catch (ApplicationUpdateException exception)
        {
            updateError = exception.Message;
            isInstallingUpdate = false;
        }
    }

    private static string FormatMoney(decimal amount) => amount.ToString("C2");

    private static string FormatOptionalMoney(decimal? amount) =>
        amount is null ? "Balance unavailable" : FormatMoney(amount.Value);

    private IReadOnlyList<string> GetCategoryOptions(string currentCategory)
    {
        var categoryNames = availableCategories
            .Select(category => category.Name)
            .ToArray();
        return categoryNames.Contains(currentCategory, StringComparer.OrdinalIgnoreCase)
            ? categoryNames
            : [currentCategory, .. categoryNames];
    }

}
