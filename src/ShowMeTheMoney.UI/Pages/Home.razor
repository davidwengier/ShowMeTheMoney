@page "/"

<PageTitle>Show Me The Money</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">Your money, made visible</p>
        <h1>Accounts</h1>
        <p class="hero-copy">
            Add an account, select it, then import its QIF transaction history.
        </p>
    </div>
</section>

@if (availableUpdate is not null)
{
    <section class="update-card">
        <div>
            <p class="eyebrow">Update available</p>
            <strong>Show Me The Money @availableUpdate.Version is ready</strong>
            <span>
                @(isInstallingUpdate
                    ? "Downloading and preparing the update..."
                    : "Install it now and the app will restart automatically.")
            </span>
        </div>
        <button class="primary-button"
                @onclick="InstallUpdateAsync"
                disabled="@isInstallingUpdate">
            @(isInstallingUpdate ? "Installing..." : "Update and restart")
        </button>
    </section>
}

@if (actionMessage is not null)
{
    <div class="message import-message">@actionMessage</div>
}

@if (errorMessage is not null)
{
    <div class="message error-message">@errorMessage</div>
}
else if (snapshot is null)
{
    <div class="loading-card">Loading accounts...</div>
}
else
{
    <section class="account-workspace">
        <article class="panel accounts-panel">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">Your accounts</p>
                    <h2>Accounts</h2>
                </div>
                <span>@snapshot.Accounts.Count</span>
            </div>

            @if (snapshot.Accounts.Count > 0)
            {
                <div class="account-list">
                    @foreach (var account in snapshot.Accounts)
                    {
                        <button class="account-row @(account.Id == selectedAccountId ? "selected" : null)"
                                @onclick="() => SelectAccount(account.Id)">
                            <div>
                                <strong>@account.Name</strong>
                                <span>@FormatOptionalMoney(account.Balance)</span>
                            </div>
                            <span class="account-chevron">›</span>
                        </button>
                    }
                </div>
            }

            <div class="add-account-form">
                <label for="new-account-name">Add an account</label>
                <div class="inline-form">
                    <input id="new-account-name"
                           placeholder="e.g. Everyday account"
                           @bind="newAccountName"
                           @bind:event="oninput"
                           @onkeydown="HandleAddAccountKeyDown" />
                    <button class="primary-button"
                            @onclick="AddAccountAsync"
                            disabled="@isWorking">
                        Add
                    </button>
                </div>
            </div>
        </article>

        @if (SelectedAccount is null)
        {
            <section class="empty-state">
                <div class="empty-state-icon">1</div>
                <p class="eyebrow">First step</p>
                <h2>Add your first account</h2>
                <p>
                    Give the account a useful name. Once selected, you can import
                    its QIF transaction history.
                </p>
            </section>
        }
        else
        {
            <div class="account-detail">
                <section class="selected-account-header">
                    <div>
                        <p class="eyebrow">Selected account</p>
                        <div class="rename-form">
                            <input aria-label="Account name"
                                   @bind="editedAccountName"
                                   @bind:event="oninput"
                                   @onkeydown="HandleRenameKeyDown" />
                            <button class="secondary-button"
                                    @onclick="RenameAccountAsync"
                                    disabled="@isWorking">
                                Save name
                            </button>
                        </div>
                    </div>
                    <button class="primary-button"
                            @onclick="ImportQifAsync"
                            disabled="@isWorking">
                        @(isWorking ? "Working..." : "Import QIF")
                    </button>
                </section>

                <section class="summary-grid">
                    <article class="summary-card">
                        <span>Money in</span>
                        <strong class="positive">@FormatMoney(summary.Income)</strong>
                    </article>
                    <article class="summary-card">
                        <span>Money out</span>
                        <strong class="negative">@FormatMoney(summary.Spending)</strong>
                    </article>
                    <article class="summary-card">
                        <span>Net cash flow</span>
                        <strong class="@(summary.NetCashFlow >= 0 ? "positive" : "negative")">
                            @FormatMoney(summary.NetCashFlow)
                        </strong>
                    </article>
                    <article class="summary-card">
                        <span>Transactions</span>
                        <strong>@SelectedTransactions.Count</strong>
                    </article>
                </section>

                <article class="panel transactions-panel">
                    <div class="panel-heading">
                        <div>
                            <p class="eyebrow">@SelectedAccount.Name</p>
                            <h2>Transactions</h2>
                        </div>
                        <span>@snapshot.DataSourceDescription</span>
                    </div>

                    @if (SelectedTransactions.Count == 0)
                    {
                        <div class="transaction-empty-state">
                            <strong>No transactions imported</strong>
                            <span>Use Import QIF to add this account's transaction history.</span>
                        </div>
                    }
                    else
                    {
                        <div class="transaction-list">
                            @foreach (var transaction in SelectedTransactions)
                            {
                                <div class="transaction-row">
                                    <div class="transaction-date">
                                        <strong>@transaction.PostedOn.Day</strong>
                                        <span>@transaction.PostedOn.ToString("MMM")</span>
                                    </div>
                                    <div class="transaction-description">
                                        <strong>@transaction.Description</strong>
                                        <span>@transaction.Category</span>
                                    </div>
                                    <strong class="@(transaction.Amount >= 0 ? "positive" : "negative")">
                                        @FormatSignedMoney(transaction.Amount)
                                    </strong>
                                </div>
                            }
                        </div>
                    }
                </article>
            </div>
        }
    </section>
}

@if (updateError is not null)
{
    <div class="message error-message update-message">@updateError</div>
}

@code {
    [Inject]
    private IBankingDataSource DataSource { get; set; } = null!;

    [Inject]
    private IBankingDataStore DataStore { get; set; } = null!;

    [Inject]
    private IQifFilePicker FilePicker { get; set; } = null!;

    [Inject]
    private QifParser Parser { get; set; } = null!;

    [Inject]
    private IApplicationUpdateService UpdateService { get; set; } = null!;

    private BankingSnapshot? snapshot;
    private TransactionSummary summary = new(0, 0, 0);
    private string? selectedAccountId;
    private string newAccountName = string.Empty;
    private string editedAccountName = string.Empty;
    private string? errorMessage;
    private string? actionMessage;
    private string? updateError;
    private ApplicationUpdate? availableUpdate;
    private bool isWorking;
    private bool isInstallingUpdate;

    private BankAccount? SelectedAccount =>
        snapshot?.Accounts.FirstOrDefault(account => account.Id == selectedAccountId);

    private IReadOnlyList<BankTransaction> SelectedTransactions =>
        snapshot?.Transactions
            .Where(transaction => transaction.AccountId == selectedAccountId)
            .OrderByDescending(transaction => transaction.PostedOn)
            .ToArray()
        ?? [];

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        await CheckForUpdateAsync();
    }

    private async Task LoadAsync(string? accountToSelect = null)
    {
        errorMessage = null;

        try
        {
            snapshot = await DataSource.GetSnapshotAsync();
            var desiredAccountId = accountToSelect ?? selectedAccountId;
            selectedAccountId = snapshot.Accounts.Any(account => account.Id == desiredAccountId)
                ? desiredAccountId
                : snapshot.Accounts.FirstOrDefault()?.Id;
            UpdateSelectedAccountState();
        }
        catch (Exception exception)
        {
            errorMessage = $"Accounts could not be loaded: {exception.Message}";
        }
    }

    private void SelectAccount(string accountId)
    {
        selectedAccountId = accountId;
        actionMessage = null;
        errorMessage = null;
        UpdateSelectedAccountState();
    }

    private void UpdateSelectedAccountState()
    {
        editedAccountName = SelectedAccount?.Name ?? string.Empty;
        summary = TransactionSummarizer.Summarize(SelectedTransactions);
    }

    private async Task AddAccountAsync()
    {
        var name = newAccountName.Trim();
        if (name.Length == 0)
        {
            errorMessage = "Enter an account name first.";
            return;
        }

        isWorking = true;
        errorMessage = null;
        actionMessage = null;
        var account = new BankAccount(
            Guid.NewGuid().ToString("N"),
            name,
            "Manual account",
            null,
            "AUD");

        try
        {
            await DataStore.AddAccountAsync(account);
            newAccountName = string.Empty;
            await LoadAsync(account.Id);
            actionMessage = $"Added {account.Name}.";
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task RenameAccountAsync()
    {
        var account = SelectedAccount;
        var name = editedAccountName.Trim();
        if (account is null || name.Length == 0)
        {
            errorMessage = "Enter an account name first.";
            return;
        }

        isWorking = true;
        errorMessage = null;
        actionMessage = null;

        try
        {
            await DataStore.RenameAccountAsync(account.Id, name);
            await LoadAsync(account.Id);
            actionMessage = $"Renamed the account to {name}.";
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task ImportQifAsync()
    {
        var account = SelectedAccount;
        if (account is null)
        {
            errorMessage = "Select an account before importing transactions.";
            return;
        }

        errorMessage = null;
        actionMessage = null;

        using var selectedFile = await FilePicker.PickAsync();
        if (selectedFile is null)
        {
            return;
        }

        isWorking = true;

        try
        {
            var result = Parser.Parse(selectedFile.Content, selectedFile.FileName);
            var transactions = result.Snapshot.Transactions
                .Select(transaction => transaction with
                {
                    Id = $"{account.Id}:{transaction.Id}",
                    AccountId = account.Id
                })
                .ToArray();
            await DataStore.ImportTransactionsAsync(
                account.Id,
                transactions,
                $"Last imported from {selectedFile.FileName}");
            await LoadAsync(account.Id);
            actionMessage = result.Warnings.Count == 0
                ? $"Imported or updated {transactions.Length} transactions in {account.Name}."
                : $"Imported or updated {transactions.Length} transactions with "
                    + $"{result.Warnings.Count} skipped records. {string.Join(" ", result.Warnings.Take(3))}";
        }
        catch (QifParseException exception)
        {
            errorMessage = exception.Message;
        }
        catch (IOException exception)
        {
            errorMessage = $"The QIF file could not be read or saved: {exception.Message}";
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task HandleAddAccountKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddAccountAsync();
        }
    }

    private async Task HandleRenameKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await RenameAccountAsync();
        }
    }

    private async Task CheckForUpdateAsync()
    {
        if (!UpdateService.CanUpdate)
        {
            return;
        }

        try
        {
            availableUpdate = await UpdateService.CheckForUpdateAsync();
        }
        catch (ApplicationUpdateException exception)
        {
            updateError = exception.Message;
        }
    }

    private async Task InstallUpdateAsync()
    {
        isInstallingUpdate = true;
        updateError = null;

        try
        {
            await UpdateService.DownloadUpdateAsync();
            UpdateService.ApplyUpdateAndRestart();
        }
        catch (ApplicationUpdateException exception)
        {
            updateError = exception.Message;
            isInstallingUpdate = false;
        }
    }

    private static string FormatMoney(decimal amount) => amount.ToString("C2");

    private static string FormatOptionalMoney(decimal? amount) =>
        amount is null ? "Balance unavailable" : FormatMoney(amount.Value);

    private static string FormatSignedMoney(decimal amount) =>
        amount >= 0 ? $"+{amount:C2}" : amount.ToString("C2");
}
