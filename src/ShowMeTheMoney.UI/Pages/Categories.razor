@page "/categories"

<PageTitle>Categories - Show Me The Money</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">Organise your transactions</p>
        <h1>Categories</h1>
        <p class="hero-copy">
            Add, rename, or delete categories, then quickly classify one
            uncategorised transaction at a time.
        </p>
    </div>
</section>

@if (actionMessage is not null)
{
    <div class="message import-message">@actionMessage</div>
}

@if (errorMessage is not null)
{
    <div class="message error-message">@errorMessage</div>
}
else if (categories is null)
{
    <div class="loading-card">Loading categories...</div>
}
else
{
    <section class="category-page-grid">
        <article class="panel category-review-panel">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">Quick review</p>
                    <h2>Random uncategorised transaction</h2>
                </div>
            </div>

            @if (uncategorisedTransaction is null)
            {
                <div class="category-review-empty">
                    <strong>Everything is categorised</strong>
                    <span>There are no uncategorised transactions to review.</span>
                </div>
            }
            else
            {
                var transaction = uncategorisedTransaction.Transaction;
                <div class="category-review-card">
                    <div class="category-review-details">
                        <span>
                            @uncategorisedTransaction.AccountName
                            &middot;
                            @transaction.PostedOn.ToString("d MMM yyyy")
                        </span>
                        <strong>@transaction.Description</strong>
                        <span class="@(transaction.Amount >= 0 ? "positive" : "negative")">
                            @FormatMoney(transaction.Amount)
                        </span>
                    </div>
                    <div class="category-review-action">
                        <label>
                            <span>Category</span>
                            <select @bind="selectedReviewCategory" disabled="@isWorking">
                                <option value="">Choose a category</option>
                                @foreach (var category in EditableCategories)
                                {
                                    <option value="@category.Name">@category.Name</option>
                                }
                                <option value="@NewCategoryOption">New...</option>
                            </select>
                        </label>
                        <button class="primary-button"
                                @onclick="BeginReviewAssignmentAsync"
                                disabled="@isWorking">
                            Categorise
                        </button>
                    </div>
                </div>
            }
        </article>

        <article class="panel categories-panel">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">Available choices</p>
                    <h2>All categories</h2>
                </div>
                <span>@EditableCategories.Count</span>
            </div>

            <div class="add-category-form">
                <label for="new-category-name">Add a category</label>
                <div class="inline-form">
                    <input id="new-category-name"
                           placeholder="e.g. Pets"
                           @bind="newCategoryName"
                           @bind:event="oninput"
                           @onkeydown="HandleAddCategoryKeyDown" />
                    <button class="primary-button"
                            @onclick="AddCategoryAsync"
                            disabled="@isWorking">
                        Add
                    </button>
                </div>
            </div>

            <div class="category-list">
                @foreach (var category in EditableCategories)
                {
                    <div class="category-row">
                        @if (categoryBeingEdited == category.Name)
                        {
                            <input aria-label="@($"New name for {category.Name}")"
                                   @bind="editedCategoryName"
                                   @bind:event="oninput"
                                   @onkeydown="HandleEditCategoryKeyDown" />
                        }
                        else
                        {
                            <strong>@category.Name</strong>
                        }

                        <div class="category-row-actions">
                            @if (categoryBeingEdited == category.Name)
                            {
                                <button class="primary-button compact-button"
                                        @onclick="SaveCategoryRenameAsync"
                                        disabled="@isWorking">
                                    Save
                                </button>
                                <button class="secondary-button compact-button"
                                        @onclick="CancelCategoryRename"
                                        disabled="@isWorking">
                                    Cancel
                                </button>
                            }
                            else if (categoryPendingDelete == category.Name)
                            {
                                <button class="secondary-button compact-button danger-button"
                                        @onclick="ConfirmDeleteCategoryAsync"
                                        disabled="@isWorking">
                                    Confirm delete
                                </button>
                                <button class="secondary-button compact-button"
                                        @onclick="CancelDeleteCategory"
                                        disabled="@isWorking">
                                    Cancel
                                </button>
                            }
                            else
                            {
                                <button class="secondary-button compact-button"
                                        @onclick="() => BeginCategoryRename(category.Name)"
                                        disabled="@isWorking">
                                    Rename
                                </button>
                                <button class="secondary-button compact-button danger-button"
                                        @onclick="() => BeginDeleteCategory(category.Name)"
                                        disabled="@isWorking">
                                    Delete
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </article>
    </section>
}

@if (transactionForNewCategory is not null)
{
    <div class="dialog-backdrop">
        <section class="category-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="review-new-category-title">
            <p class="eyebrow">Custom category</p>
            <h2 id="review-new-category-title">Create a category</h2>
            <p class="muted">
                Create a category for
                <strong>@transactionForNewCategory.Description</strong>:
            </p>
            <label>
                <span>Category name</span>
                <input autofocus
                       aria-label="New category name"
                       @bind="reviewNewCategoryName"
                       @bind:event="oninput"
                       @onkeydown="HandleReviewNewCategoryKeyDown" />
            </label>
            @if (reviewNewCategoryError is not null)
            {
                <span class="dialog-error">@reviewNewCategoryError</span>
            }
            <div class="dialog-actions">
                <button class="secondary-button"
                        @onclick="CancelReviewNewCategory"
                        disabled="@isWorking">
                    Cancel
                </button>
                <button class="primary-button"
                        @onclick="ContinueReviewNewCategoryAsync"
                        disabled="@isWorking">
                    Continue
                </button>
            </div>
        </section>
    </div>
}

@if (assignmentTransaction is not null
    && assignmentCategory is not null
    && assignmentPreview is not null)
{
    <div class="dialog-backdrop">
        <section class="category-dialog assignment-dialog"
                 role="dialog"
                 aria-modal="true"
                 aria-labelledby="review-assignment-title">
            <p class="eyebrow">Apply category</p>
            <h2 id="review-assignment-title">@assignmentCategory</h2>
            <p class="muted">
                <strong>@assignmentTransaction.Description</strong> has
                @assignmentPreview.OtherMatchingCount other matching
                @(assignmentPreview.OtherMatchingCount == 1 ? "transaction" : "transactions").
                @assignmentPreview.OtherUncategorisedCount of those
                @(assignmentPreview.OtherUncategorisedCount == 1 ? "is" : "are")
                uncategorised.
            </p>
            <div class="assignment-actions">
                <button class="primary-button"
                        @onclick="() => ConfirmAssignmentAsync(TransactionCategoryAssignmentScope.AllMatching)"
                        disabled="@isWorking">
                    Update all @(assignmentPreview.OtherMatchingCount + 1) transactions
                </button>
                <button class="secondary-button"
                        @onclick="() => ConfirmAssignmentAsync(TransactionCategoryAssignmentScope.MatchingUncategorised)"
                        disabled="@(isWorking || assignmentPreview.OtherUncategorisedCount == 0)">
                    Update this and @assignmentPreview.OtherUncategorisedCount uncategorised
                </button>
                <button class="secondary-button"
                        @onclick="() => ConfirmAssignmentAsync(TransactionCategoryAssignmentScope.SelectedOnly)"
                        disabled="@isWorking">
                    Do nothing to other transactions
                </button>
                <button class="secondary-button"
                        @onclick="CancelAssignment"
                        disabled="@isWorking">
                    Cancel
                </button>
            </div>
        </section>
    </div>
}

@code {
    private const string NewCategoryOption = "__new_category__";

    [Inject]
    private IBankingDataStore DataStore { get; set; } = null!;

    private IReadOnlyList<TransactionCategory>? categories;
    private IReadOnlyList<TransactionCategory> EditableCategories =>
        categories?
            .Where(category => !category.Name.Equals(
                TransactionCategories.Uncategorised,
                StringComparison.OrdinalIgnoreCase))
            .ToArray()
        ?? [];
    private UncategorisedTransaction? uncategorisedTransaction;
    private string selectedReviewCategory = string.Empty;
    private string newCategoryName = string.Empty;
    private string editedCategoryName = string.Empty;
    private string? categoryBeingEdited;
    private string? categoryPendingDelete;
    private BankTransaction? transactionForNewCategory;
    private string reviewNewCategoryName = string.Empty;
    private string? reviewNewCategoryError;
    private BankTransaction? assignmentTransaction;
    private string? assignmentCategory;
    private TransactionCategoryAssignmentPreview? assignmentPreview;
    private string? actionMessage;
    private string? errorMessage;
    private bool isWorking;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            categories = await DataStore.GetTransactionCategoriesAsync();
            uncategorisedTransaction =
                await DataStore.GetRandomUncategorisedTransactionAsync();
            selectedReviewCategory = string.Empty;
        }
        catch (Exception exception)
        {
            errorMessage = $"Categories could not be loaded: {exception.Message}";
        }
    }

    private async Task AddCategoryAsync()
    {
        var name = newCategoryName.Trim();
        if (name.Length == 0)
        {
            errorMessage = "Enter a category name.";
            return;
        }

        await RunActionAsync(
            async () =>
            {
                await DataStore.AddTransactionCategoryAsync(name);
                newCategoryName = string.Empty;
                actionMessage = $"Added {name}.";
                await ReloadCategoriesAsync();
            });
    }

    private void BeginCategoryRename(string name)
    {
        categoryPendingDelete = null;
        categoryBeingEdited = name;
        editedCategoryName = name;
        actionMessage = null;
        errorMessage = null;
    }

    private async Task SaveCategoryRenameAsync()
    {
        var currentName = categoryBeingEdited;
        var newName = editedCategoryName.Trim();
        if (currentName is null || newName.Length == 0)
        {
            errorMessage = "Enter a category name.";
            return;
        }

        await RunActionAsync(
            async () =>
            {
                await DataStore.RenameTransactionCategoryAsync(currentName, newName);
                categoryBeingEdited = null;
                actionMessage = $"Renamed {currentName} to {newName}.";
                await ReloadCategoriesAsync();
            });
    }

    private void CancelCategoryRename()
    {
        categoryBeingEdited = null;
        editedCategoryName = string.Empty;
        errorMessage = null;
    }

    private void BeginDeleteCategory(string name)
    {
        categoryBeingEdited = null;
        categoryPendingDelete = name;
        actionMessage = null;
        errorMessage = null;
    }

    private async Task ConfirmDeleteCategoryAsync()
    {
        var name = categoryPendingDelete;
        if (name is null)
        {
            return;
        }

        await RunActionAsync(
            async () =>
            {
                await DataStore.DeleteTransactionCategoryAsync(name);
                categoryPendingDelete = null;
                actionMessage =
                    $"Deleted {name}. Its transactions are now uncategorised.";
                await ReloadCategoriesAsync();
                uncategorisedTransaction =
                    await DataStore.GetRandomUncategorisedTransactionAsync();
            });
    }

    private void CancelDeleteCategory()
    {
        categoryPendingDelete = null;
    }

    private async Task BeginReviewAssignmentAsync()
    {
        var transaction = uncategorisedTransaction?.Transaction;
        if (transaction is null || string.IsNullOrWhiteSpace(selectedReviewCategory))
        {
            errorMessage = "Choose a category first.";
            return;
        }

        if (selectedReviewCategory == NewCategoryOption)
        {
            transactionForNewCategory = transaction;
            reviewNewCategoryName = string.Empty;
            reviewNewCategoryError = null;
            return;
        }

        await PrepareAssignmentAsync(transaction, selectedReviewCategory);
    }

    private async Task ContinueReviewNewCategoryAsync()
    {
        var transaction = transactionForNewCategory;
        var category = reviewNewCategoryName.Trim();
        if (transaction is null)
        {
            return;
        }

        if (category.Length == 0)
        {
            reviewNewCategoryError = "Enter a category name.";
            return;
        }

        CancelReviewNewCategory();
        await PrepareAssignmentAsync(transaction, category);
    }

    private void CancelReviewNewCategory()
    {
        transactionForNewCategory = null;
        reviewNewCategoryName = string.Empty;
        reviewNewCategoryError = null;
    }

    private async Task PrepareAssignmentAsync(BankTransaction transaction, string category)
    {
        await RunActionAsync(
            async () =>
            {
                assignmentPreview =
                    await DataStore.GetTransactionCategoryAssignmentPreviewAsync(transaction.Id);
                assignmentTransaction = transaction;
                assignmentCategory = category;
            });
    }

    private async Task ConfirmAssignmentAsync(TransactionCategoryAssignmentScope scope)
    {
        var transaction = assignmentTransaction;
        var category = assignmentCategory;
        if (transaction is null || category is null)
        {
            return;
        }

        await RunActionAsync(
            async () =>
            {
                await DataStore.SetTransactionCategoryAsync(transaction.Id, category, scope);
                CancelAssignment();
                await ReloadCategoriesAsync();
                uncategorisedTransaction =
                    await DataStore.GetRandomUncategorisedTransactionAsync();
                selectedReviewCategory = string.Empty;
                actionMessage = scope switch
                {
                    TransactionCategoryAssignmentScope.AllMatching =>
                        $"Categorised all matching transactions as {category}.",
                    TransactionCategoryAssignmentScope.MatchingUncategorised =>
                        $"Categorised this and matching uncategorised transactions as {category}.",
                    _ => $"Categorised only this transaction as {category}."
                };
            });
    }

    private void CancelAssignment()
    {
        assignmentTransaction = null;
        assignmentCategory = null;
        assignmentPreview = null;
    }

    private async Task ReloadCategoriesAsync()
    {
        categories = await DataStore.GetTransactionCategoriesAsync();
        if (!categories.Any(category =>
                category.Name.Equals(
                    selectedReviewCategory,
                    StringComparison.OrdinalIgnoreCase)))
        {
            selectedReviewCategory = string.Empty;
        }
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        isWorking = true;
        errorMessage = null;
        actionMessage = null;
        try
        {
            await action();
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task HandleAddCategoryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await AddCategoryAsync();
        }
    }

    private async Task HandleEditCategoryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await SaveCategoryRenameAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelCategoryRename();
        }
    }

    private async Task HandleReviewNewCategoryKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
        {
            await ContinueReviewNewCategoryAsync();
        }
        else if (args.Key == "Escape")
        {
            CancelReviewNewCategory();
        }
    }

    private static string FormatMoney(decimal amount) => amount.ToString("C2");
}
