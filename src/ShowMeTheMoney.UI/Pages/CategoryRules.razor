@page "/category-rules"

<PageTitle>Category Rules - Show Me The Money</PageTitle>

<section class="hero">
    <div>
        <p class="eyebrow">How transactions are classified</p>
        <h1>Category rules</h1>
        <p class="hero-copy">
            Rules are checked in order of specificity. Exact rules take priority
            over description matches, while no automatic match keeps a payee manual.
        </p>
    </div>
</section>

@if (actionMessage is not null)
{
    <div class="message import-message">@actionMessage</div>
}

@if (errorMessage is not null)
{
    <div class="message error-message">@errorMessage</div>
}
else if (rules is null || categories is null)
{
    <div class="loading-card">Loading category rules...</div>
}
else
{
    <section class="rules-grid">
        <article class="panel rules-panel">
            <div class="panel-heading">
                <div>
                    <p class="eyebrow">Automatic categorisation</p>
                    <h2>Rules</h2>
                </div>
                <button class="primary-button compact-button"
                        @onclick="AddRule"
                        disabled="@(isWorking || EditableCategories.Count == 0)">
                    Add rule
                </button>
            </div>

            @if (rules.Count == 0)
            {
                <div class="rules-empty">
                    <strong>No category rules</strong>
                    <span>Add one here or categorise a transaction to create an exact rule.</span>
                </div>
            }
            else
            {
                <div class="rules-table editable-rules-table">
                    <div class="rules-header">
                        <span>Pattern</span>
                        <span>Category</span>
                        <span>Match type</span>
                        <span>Actions</span>
                    </div>
                    @foreach (var rule in rules)
                    {
                        <div class="rule-row">
                            <input aria-label="Rule pattern"
                                   @bind="rule.Pattern"
                                   @bind:event="oninput"
                                   disabled="@isWorking" />
                            <select aria-label="Rule category"
                                    @bind="rule.Category"
                                    disabled="@isWorking">
                                @foreach (var category in EditableCategories)
                                {
                                    <option value="@category.Name">@category.Name</option>
                                }
                            </select>
                            <select aria-label="Rule match type"
                                    @bind="rule.Match"
                                    disabled="@isWorking">
                                @foreach (var match in MatchTypes)
                                {
                                    <option value="@match">@DescribeMatch(match)</option>
                                }
                            </select>
                            <div class="rule-row-actions">
                                <button class="primary-button compact-button"
                                        @onclick="() => SaveRuleAsync(rule)"
                                        disabled="@isWorking">
                                    Save
                                </button>
                                <button class="secondary-button compact-button danger-button"
                                        @onclick="() => DeleteRuleAsync(rule)"
                                        disabled="@isWorking">
                                    Delete
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        </article>
    </section>
}

@code {
    [Inject]
    private IBankingDataStore DataStore { get; set; } = null!;

    private static IReadOnlyList<TransactionCategoryRuleMatch> MatchTypes { get; } =
        Enum.GetValues<TransactionCategoryRuleMatch>();

    private List<EditableRule>? rules;
    private IReadOnlyList<TransactionCategory>? categories;
    private IReadOnlyList<TransactionCategory> EditableCategories =>
        categories?
            .Where(category => !category.Name.Equals(
                TransactionCategories.Uncategorised,
                StringComparison.OrdinalIgnoreCase))
            .ToArray()
        ?? [];
    private string? actionMessage;
    private string? errorMessage;
    private bool isWorking;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            var storedRules = await DataStore.GetTransactionCategoryRulesAsync();
            categories = await DataStore.GetTransactionCategoriesAsync();
            rules = storedRules.Select(rule => new EditableRule(rule)).ToList();
        }
        catch (Exception exception)
        {
            errorMessage = $"Category rules could not be loaded: {exception.Message}";
        }
    }

    private void AddRule()
    {
        var category = EditableCategories.FirstOrDefault()?.Name;
        if (category is null)
        {
            errorMessage = "Add a category before creating a rule.";
            return;
        }

        rules!.Insert(
            0,
            new EditableRule(
                originalPattern: null,
                pattern: string.Empty,
                category: category,
                match: TransactionCategoryRuleMatch.DescriptionContains));
        actionMessage = null;
        errorMessage = null;
    }

    private async Task SaveRuleAsync(EditableRule editableRule)
    {
        if (string.IsNullOrWhiteSpace(editableRule.Pattern))
        {
            errorMessage = "Enter a rule pattern.";
            return;
        }

        await RunActionAsync(
            async () =>
            {
                await DataStore.SaveTransactionCategoryRuleAsync(
                    editableRule.OriginalPattern,
                    new TransactionCategoryRule(
                        editableRule.Pattern,
                        editableRule.Category,
                        editableRule.Match));
                actionMessage = $"Saved the {editableRule.Pattern.Trim()} rule.";
                await LoadAsync();
            });
    }

    private async Task DeleteRuleAsync(EditableRule editableRule)
    {
        var pattern = editableRule.OriginalPattern ?? editableRule.Pattern;
        if (string.IsNullOrWhiteSpace(pattern))
        {
            rules!.Remove(editableRule);
            return;
        }

        await RunActionAsync(
            async () =>
            {
                await DataStore.DeleteTransactionCategoryRuleAsync(pattern);
                actionMessage = $"Deleted the {pattern} rule.";
                await LoadAsync();
            });
    }

    private async Task RunActionAsync(Func<Task> action)
    {
        isWorking = true;
        errorMessage = null;
        actionMessage = null;
        try
        {
            await action();
        }
        catch (InvalidOperationException exception)
        {
            errorMessage = exception.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private static string DescribeMatch(TransactionCategoryRuleMatch match) =>
        match switch
        {
            TransactionCategoryRuleMatch.NoAutomaticMatch => "No automatic match",
            TransactionCategoryRuleMatch.ExactDescription => "Exact description",
            TransactionCategoryRuleMatch.MoneyInDescriptionContains =>
                "Money in description contains",
            _ => "Description contains"
        };

    private sealed class EditableRule
    {
        public EditableRule(TransactionCategoryRule rule)
            : this(rule.Pattern, rule.Pattern, rule.Category, rule.Match)
        {
        }

        public EditableRule(
            string? originalPattern,
            string pattern,
            string category,
            TransactionCategoryRuleMatch match)
        {
            OriginalPattern = originalPattern;
            Pattern = pattern;
            Category = category;
            Match = match;
        }

        public string? OriginalPattern { get; }

        public string Pattern { get; set; }

        public string Category { get; set; }

        public TransactionCategoryRuleMatch Match { get; set; }
    }
}
